{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$env:Path = \"$env:LOCALAPPDATA\\Programs\\node;$env:Path\"; node .claude/hooks/run-pipeline.js",
            "timeout": 120,
            "statusMessage": "Конвейер «Навар»: проверяю эталоны…"
          }
        ]
      }
    ]
  }
}
