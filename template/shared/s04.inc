  .panel{background:var(--paper);color:var(--ink);border-radius:var(--radius);overflow:hidden}
  .group{padding:20px 22px;border-bottom:1px solid var(--paper-line)}
  .group:last-child{border-bottom:none}
  .group-head{display:flex;align-items:baseline;gap:10px;margin-bottom:15px}
  .group-title{font-size:14px;font-weight:800;letter-spacing:-0.01em}
  .group-note{font-size:12px;color:var(--ink-mut);margin-left:auto;text-align:right}

  .field{margin-bottom:13px}
  .field:last-child{margin-bottom:0}
  .field label{display:block;font-size:12.5px;color:var(--ink-mut);margin-bottom:6px;font-weight:600}
  .input-wrap{position:relative;display:flex;align-items:center}
  .input-wrap .unit{position:absolute;right:12px;font-size:13px;color:#9AA5AF;pointer-events:none;font-weight:700}
  input.fin{
    width:100%;font-family:var(--sans);font-size:16px;font-weight:700;color:var(--ink);
