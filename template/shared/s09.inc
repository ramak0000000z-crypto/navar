  .compare{max-width:1140px;margin:0 auto 22px;padding:0 24px}
  .compare-panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:20px 22px}
  .compare-head{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:6px}
  .compare-title{font-size:15px;font-weight:800}
  .compare-sub{font-size:12px;color:var(--muted)}
  .compare-actions{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}
  .btn{
    font-family:var(--sans);font-size:12.5px;font-weight:700;cursor:pointer;border-radius:9px;
    padding:9px 14px;border:1px solid var(--line);background:var(--panel-2);color:var(--text);transition:.12s;
  }
  .btn:hover{border-color:var(--green-deep)}
  .btn.primary{background:var(--green);border-color:var(--green);color:#0B2416}
  .btn.primary:hover{background:#4BE38A}
