
  .waterfall{margin:20px 0 4px}
  .wf-title{font-size:12px;color:var(--muted);font-weight:600;margin-bottom:9px}
  .wf-bar{display:flex;height:34px;border-radius:9px;overflow:hidden;background:var(--panel-2)}
  .wf-seg{transition:width .25s ease;min-width:0}
  .wf-legend{display:flex;flex-wrap:wrap;gap:9px 16px;margin-top:12px}
  .wf-item{display:flex;align-items:center;gap:6px;font-size:12px;color:#B9C2CC}
  .wf-item .sw{width:9px;height:9px;border-radius:3px;flex:none}
  .wf-item .amt{color:#fff;font-weight:700;font-variant-numeric:tabular-nums;margin-left:2px}
